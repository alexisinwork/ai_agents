# Copy to .env and fill in. .env is gitignored.
#
# Both names hold the same OpenAI key. The VITE_ prefix is what makes Vite
# expose it to the browser bundle — which also means it is readable by anyone
# who opens the page, so this setup is for local practice only.
VITE_OPENAI_API_KEY=sk-...

# Read by the Node smoke test (npm run eval) via --env-file.
OPENAI_API_KEY=sk-...

# The location and weather APIs (ipapi.co, open-meteo.com) need no keys.
